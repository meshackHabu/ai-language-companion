{
  "name": "ai-language-companion-backend",
  "version": "1.0.0",
  "description": "Starter backend for the AI Language Companion",
  "main": "server.js",
  "scripts": {
    "make-admin": "node scripts/make-admin.js",
    "import:dataset": "node scripts/import-tatoeba-dataset.js",
    "dev": "node server.js",
    "start": "node server.js",
    "mock-server": "node mock-server.js",
    "test": "jest --coverage --verbose",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration --runInBand",
    "test:mock-server": "npm run mock-server",
    "test:all": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "openai": "^6.39.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "ajv": "^8.12.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  }
}
